{
	"name": "@openapi-to/core",
	"version": "4.0.0-rc.1",
	"description": "Compiler and plugin runtime for deterministic OpenAPI code generation",
	"keywords": [
		"typescript",
		"plugins",
		"codegen"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/Vc-great/openapi-to.git",
		"directory": "packages/core"
	},
	"bugs": {
		"url": "https://github.com/Vc-great/openapi-to/issues"
	},
	"homepage": "https://github.com/Vc-great/openapi-to#readme",
	"license": "MIT",
	"author": "Vc-great",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs",
			"default": "./dist/index.cjs"
		},
		"./utils": {
			"types": "./dist/utils.d.ts",
			"import": "./dist/utils.js",
			"require": "./dist/utils.cjs",
			"default": "./dist/utils.cjs"
		},
		"./package.json": "./package.json",
		"./*": "./*"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"src",
		"dist",
		"*.d.ts",
		"*.d.cts",
		"schema.json",
		"!src/openapi/fixtures/**",
		"!dist/**/*.map",
		"!/**/**.test.**",
		"!/**/__tests__/**"
	],
	"scripts": {
		"build": "pnpm run clean && pnpm exec tsup",
		"clean": "pnpm exec rimraf ./dist",
		"lint": "pnpm exec biome lint .",
		"lint:fix": "pnpm exec biome lint --write --unsafe .",
		"start": "pnpm run clean && pnpm exec tsup --watch",
		"test": "pnpm exec vitest run --passWithNoTests",
		"typecheck": "pnpm exec tsc -p ./tsconfig.json --noEmit --emitDeclarationOnly false"
	},
	"dependencies": {
		"@types/json-schema": "^7.0.15",
		"axios": "1.9.0",
		"bundle-require": "^4.0.2",
		"code-block-writer": "^12.0.0",
		"consola": "^3.2.3",
		"cosmiconfig": "^8.3.6",
		"directory-tree": "^3.5.1",
		"do-swagger2openapi": "^7.0.18",
		"esbuild-fix-imports-plugin": "^1.0.20",
		"eventemitter3": "^5.0.1",
		"esbuild": "^0.25.2",
		"execa": "^8.0.1",
		"find-up": "^7.0.0",
		"fs-extra": "^11.2.0",
		"is-chinese": "^2.0.0",
		"is-url": "^1.2.4",
		"js-yaml": "4.1.0",
		"js-runtime": "^0.0.7",
		"json-schema": "^0.4.0",
		"lodash": "^4.17.21",
		"natural-orderby": "^3.0.2",
		"oas": "^24.9.0",
		"openapi-types": "^12.1.3",
		"picocolors": "^1.0.0",
		"pinyin-pro": "^3.25.0",
		"seedrandom": "^3.0.5",
		"semver": "^7.5.4",
		"tinyrainbow": "^1.2.0",
		"ts-morph": "^23.0.0"
	},
	"devDependencies": {
		"@openapi-to/config-ts": "workspace:*",
		"@openapi-to/config-tsup": "workspace:*",
		"@types/fs-extra": "^11.0.4",
		"@types/js-yaml": "^4.0.9",
		"@types/is-url": "^1.2.32",
		"@types/lodash": "^4.17.9",
		"@types/seedrandom": "^3.0.8",
		"@types/semver": "^7.5.6",
		"ora": "^7.0.1"
	},
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}
